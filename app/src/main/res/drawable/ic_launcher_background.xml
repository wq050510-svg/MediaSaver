<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep ocean navy to electric cobalt & cyan aurora diagonal gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="104"
                android:endY="104"
                android:startX="4"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#0B132B"
                    android:offset="0.0" />
                <item
                    android:color="#1D4ED8"
                    android:offset="0.55" />
                <item
                    android:color="#06B6D4"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft aurora glow orb top-right -->
    <path android:pathData="M78,24m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="78"
                android:centerY="24"
                android:gradientRadius="38"
                android:type="radial">
                <item
                    android:color="#5538BDF8"
                    android:offset="0.0" />
                <item
                    android:color="#0038BDF8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle warm violet glow bottom-left for depth -->
    <path android:pathData="M24,86m-36,0a36,36 0,1 1,72 0a36,36 0,1 1,-72 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="86"
                android:gradientRadius="36"
                android:type="radial">
                <item
                    android:color="#408B5CF6"
                    android:offset="0.0" />
                <item
                    android:color="#008B5CF6"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
